        <mxCell id="n_16" value=":MySQL" style="text;html=1;whiteSpace=wrap;rounded=0;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=11;fontStyle=2;fontColor=#6b7280;spacing=2;" vertex="1" parent="1"><mxGeometry x="1340" y="82" width="210" height="30" as="geometry"/></mxCell>
        <mxCell id="n_17" value="db: agriuno" style="text;html=1;whiteSpace=wrap;rounded=0;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=11;fontStyle=2;fontColor=#6b7280;spacing=2;" vertex="1" parent="1"><mxGeometry x="1340" y="116" width="210" height="16" as="geometry"/></mxCell>
        <mxCell id="n_18" value="1. pilih petani penyetor pada kotak daftar, isi jenis komoditas, berat, dan tanggal" style="text;html=1;whiteSpace=wrap;rounded=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f2937;spacing=2;" vertex="1" parent="1"><mxGeometry x="165" y="150" width="620" height="22" as="geometry"/></mxCell>
        <mxCell id="l_19" style="endArrow=block;html=1;rounded=0;strokeColor=#1f2937;strokeWidth=1.4;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="165" y="168" as="sourcePoint"/><mxPoint x="485" y="168" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="n_20" value="2. klik 'Simpan'  -&gt;  simpan()" style="text;html=1;whiteSpace=wrap;rounded=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f2937;spacing=2;" vertex="1" parent="1"><mxGeometry x="485" y="186" width="700" height="22" as="geometry"/></mxCell>
        <mxCell id="l_21" style="endArrow=block;html=1;rounded=0;strokeColor=#1f2937;strokeWidth=1.4;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="485" y="204" as="sourcePoint"/><mxPoint x="805" y="204" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="n_22" value="3. tambah_panen(id_petani, jenis, berat, tanggal)  -&gt;  validasi kolom, float(berat) &gt; 0, tanggal YYYY-MM-DD" style="text;html=1;whiteSpace=wrap;rounded=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f2937;spacing=2;" vertex="1" parent="1"><mxGeometry x="805" y="222" width="820" height="22" as="geometry"/></mxCell>
        <mxCell id="l_23" style="endArrow=block;html=1;rounded=0;strokeColor=#1f2937;strokeWidth=1.4;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="805" y="240" as="sourcePoint"/><mxPoint x="1125" y="240" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="n_24" value="4. exists(id_petani)  -&gt;  BR-01" style="text;html=1;whiteSpace=wrap;rounded=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f2937;spacing=2;" vertex="1" parent="1"><mxGeometry x="1125" y="258" width="700" height="22" as="geometry"/></mxCell>
        <mxCell id="l_25" style="endArrow=block;html=1;rounded=0;strokeColor=#1f2937;strokeWidth=1.4;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1125" y="276" as="sourcePoint"/><mxPoint x="1445" y="276" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="n_26" value="5. SELECT id_petani FROM petani WHERE id_petani = %s" style="text;html=1;whiteSpace=wrap;rounded=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f2937;spacing=2;" vertex="1" parent="1"><mxGeometry x="1445" y="294" width="700" height="22" as="geometry"/></mxCell>
        <mxCell id="l_27" style="endArrow=block;html=1;rounded=0;strokeColor=#1f2937;strokeWidth=1.4;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1445" y="312" as="sourcePoint"/><mxPoint x="1125" y="312" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="n_28" value="6. insert(id_petani, jenis, berat, tanggal)" style="text;html=1;whiteSpace=wrap;rounded=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f2937;spacing=2;" vertex="1" parent="1"><mxGeometry x="1125" y="330" width="700" height="22" as="geometry"/></mxCell>
        <mxCell id="l_29" style="endArrow=block;html=1;rounded=0;strokeColor=#1f2937;strokeWidth=1.4;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1125" y="348" as="sourcePoint"/><mxPoint x="1445" y="348" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="n_30" value="7. INSERT INTO inventori_panen (...) / commit()" style="text;html=1;whiteSpace=wrap;rounded=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f2937;spacing=2;" vertex="1" parent="1"><mxGeometry x="1445" y="366" width="780" height="22" as="geometry"/></mxCell>
        <mxCell id="l_31" style="endArrow=block;html=1;rounded=0;strokeColor=#1f2937;strokeWidth=1.4;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1445" y="384" as="sourcePoint"/><mxPoint x="1125" y="384" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="n_32" value="8. True" style="text;html=1;whiteSpace=wrap;rounded=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f2937;spacing=2;" vertex="1" parent="1"><mxGeometry x="1125" y="402" width="640" height="22" as="geometry"/></mxCell>
        <mxCell id="l_33" style="endArrow=block;html=1;rounded=0;strokeColor=#1f2937;strokeWidth=1.4;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1125" y="420" as="sourcePoint"/><mxPoint x="805" y="420" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="n_34" value="9. (True, 'Setoran panen berhasil dicatat!')" style="text;html=1;whiteSpace=wrap;rounded=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f2937;spacing=2;" vertex="1" parent="1"><mxGeometry x="805" y="438" width="700" height="22" as="geometry"/></mxCell>
        <mxCell id="l_35" style="endArrow=block;html=1;rounded=0;strokeColor=#1f2937;strokeWidth=1.4;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="805" y="456" as="sourcePoint"/><mxPoint x="485" y="456" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="n_36" value="10. load_table()  -&gt;  get_panen()  -&gt;  get_all() dengan LEFT JOIN dan perhitungan sisa_stok = jumlah_berat - SUM(jumlah_dikirim)" style="text;html=1;whiteSpace=wrap;rounded=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f2937;spacing=2;" vertex="1" parent="1"><mxGeometry x="485" y="474" width="900" height="22" as="geometry"/></mxCell>
        <mxCell id="l_37" style="endArrow=block;html=1;rounded=0;strokeColor=#1f2937;strokeWidth=1.4;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="485" y="492" as="sourcePoint"/><mxPoint x="805" y="492" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="l_38" style="endArrow=block;html=1;rounded=0;strokeColor=#1f2937;strokeWidth=1.4;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="805" y="510" as="sourcePoint"/><mxPoint x="1125" y="510" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="n_39" value="11. SELECT ... COALESCE(SUM(d.jumlah_dikirim),0) AS total_dikirim, (p.jumlah_berat - ...) AS sisa_stok" style="text;html=1;whiteSpace=wrap;rounded=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f2937;spacing=2;" vertex="1" parent="1"><mxGeometry x="1445" y="528" width="820" height="22" as="geometry"/></mxCell>
        <mxCell id="l_40" style="endArrow=block;html=1;rounded=0;strokeColor=#1f2937;strokeWidth=1.4;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1445" y="546" as="sourcePoint"/><mxPoint x="485" y="546" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="n_41" value="12. tampilkan kolom Sisa Stok dan kotak dialog sukses" style="text;html=1;whiteSpace=wrap;rounded=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f2937;spacing=2;" vertex="1" parent="1"><mxGeometry x="485" y="564" width="700" height="22" as="geometry"/></mxCell>
        <mxCell id="l_42" style="endArrow=block;html=1;rounded=0;strokeColor=#1f2937;strokeWidth=1.4;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="485" y="582" as="sourcePoint"/><mxPoint x="165" y="582" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="n_43" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#dc2626;strokeWidth=1.2;dashed=0;" vertex="1" parent="1"><mxGeometry x="60" y="610" width="1580" height="140" as="geometry"/></mxCell>
        <mxCell id="n_44" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dc2626;strokeColor=#dc2626;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="60" y="610" width="1580" height="28" as="geometry"/></mxCell>
        <mxCell id="n_45" value="else [validasi gagal]" style="text;html=1;whiteSpace=wrap;rounded=0;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=14;fontStyle=1;fontColor=#1b4332;spacing=2;" vertex="1" parent="1"><mxGeometry x="70" y="612" width="1560" height="24" as="geometry"/></mxCell>
        <mxCell id="n_46" value="13. (False, ...)  -  'Seluruh kolom setoran panen wajib diisi!' / 'Jumlah berat harus berupa angka numerik!' / 'Jumlah berat panen harus berupa angka positif!' / 'Tanggal panen harus berformat YYYY-MM-DD!' / 'ID Petani tidak terdaftar di sistem!'" style="text;html=1;whiteSpace=wrap;rounded=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f2937;spacing=2;" vertex="1" parent="1"><mxGeometry x="805" y="652" width="900" height="22" as="geometry"/></mxCell>
        <mxCell id="l_47" style="endArrow=block;html=1;rounded=0;strokeColor=#1f2937;strokeWidth=1.4;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="805" y="670" as="sourcePoint"/><mxPoint x="485" y="670" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="l_48" style="endArrow=block;html=1;rounded=0;strokeColor=#1f2937;strokeWidth=1.4;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="485" y="688" as="sourcePoint"/><mxPoint x="165" y="688" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="n_49" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#dc2626;strokeWidth=1.2;dashed=0;" vertex="1" parent="1"><mxGeometry x="60" y="760" width="1580" height="70" as="geometry"/></mxCell>
        <mxCell id="n_50" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dc2626;strokeColor=#dc2626;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="60" y="760" width="1580" height="28" as="geometry"/></mxCell>
        <mxCell id="n_51" value="else [pembaruan: berat baru di bawah total yang sudah dialokasikan (BR-02)]" style="text;html=1;whiteSpace=wrap;rounded=0;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=14;fontStyle=1;fontColor=#1b4332;spacing=2;" vertex="1" parent="1"><mxGeometry x="70" y="762" width="1560" height="24" as="geometry"/></mxCell>
        <mxCell id="n_52" value="14. (False, 'Berat baru lebih kecil daripada total yang sudah dialokasikan. Ubah alokasi distribusi terlebih dahulu.')" style="text;html=1;whiteSpace=wrap;rounded=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f2937;spacing=2;" vertex="1" parent="1"><mxGeometry x="805" y="796" width="1000" height="22" as="geometry"/></mxCell>
