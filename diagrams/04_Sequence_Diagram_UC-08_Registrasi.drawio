        <mxCell id="n_42" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#dc2626;strokeWidth=1.2;dashed=0;" vertex="1" parent="1"><mxGeometry x="60" y="600" width="1580" height="140" as="geometry"/></mxCell>
