        <mxCell id="n_36" value="10. (True, 'Registrasi berhasil!')" style="text;html=1;whiteSpace=wrap;rounded=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f2937;spacing=2;" vertex="1" parent="1"><mxGeometry x="1125" y="474" width="640" height="22" as="geometry"/></mxCell>
