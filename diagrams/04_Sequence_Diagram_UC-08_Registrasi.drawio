        <mxCell id="n_22" value="3. isi nama lengkap, username, password, konfirmasi, dan peran" style="text;html=1;whiteSpace=wrap;rounded=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f2937;spacing=2;" vertex="1" parent="1"><mxGeometry x="165" y="222" width="620" height="22" as="geometry"/></mxCell>
        <mxCell id="l_23" style="endArrow=block;html=1;rounded=0;strokeColor=#1f2937;strokeWidth=1.4;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="165" y="240" as="sourcePoint"/><mxPoint x="485" y="240" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="n_24" value="4. klik 'Daftar Sekarang'  -&gt;  proses_registrasi()" style="text;html=1;whiteSpace=wrap;rounded=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f2937;spacing=2;" vertex="1" parent="1"><mxGeometry x="485" y="258" width="700" height="22" as="geometry"/></mxCell>
        <mxCell id="l_25" style="endArrow=block;html=1;rounded=0;strokeColor=#1f2937;strokeWidth=1.4;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="485" y="276" as="sourcePoint"/><mxPoint x="805" y="276" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="n_26" value="5. UserController.daftar(...)" style="text;html=1;whiteSpace=wrap;rounded=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f2937;spacing=2;" vertex="1" parent="1"><mxGeometry x="805" y="294" width="640" height="22" as="geometry"/></mxCell>
        <mxCell id="l_27" style="endArrow=block;html=1;rounded=0;strokeColor=#1f2937;strokeWidth=1.4;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="805" y="312" as="sourcePoint"/><mxPoint x="1125" y="312" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="n_28" value="6. validasi: username &gt;= 4 karakter &amp; unik, password &gt;= 6 karakter, konfirmasi sama, peran harus 'operator' atau 'petani' (BR-06 s.d. BR-08)" style="text;html=1;whiteSpace=wrap;rounded=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f2937;spacing=2;" vertex="1" parent="1"><mxGeometry x="1125" y="330" width="860" height="22" as="geometry"/></mxCell>
        <mxCell id="l_29" style="endArrow=block;html=1;rounded=0;strokeColor=#1f2937;strokeWidth=1.4;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1125" y="348" as="sourcePoint"/><mxPoint x="1445" y="348" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="n_30" value="7. SELECT id_user FROM users WHERE username = %s" style="text;html=1;whiteSpace=wrap;rounded=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f2937;spacing=2;" vertex="1" parent="1"><mxGeometry x="1445" y="366" width="700" height="22" as="geometry"/></mxCell>
        <mxCell id="l_31" style="endArrow=block;html=1;rounded=0;strokeColor=#1f2937;strokeWidth=1.4;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1445" y="384" as="sourcePoint"/><mxPoint x="1125" y="384" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="n_32" value="8. salt = generate_salt()  -&gt;  hash = SHA-256(salt + password)" style="text;html=1;whiteSpace=wrap;rounded=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f2937;spacing=2;" vertex="1" parent="1"><mxGeometry x="1125" y="402" width="860" height="22" as="geometry"/></mxCell>
        <mxCell id="l_33" style="endArrow=block;html=1;rounded=0;strokeColor=#1f2937;strokeWidth=1.4;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1125" y="420" as="sourcePoint"/><mxPoint x="1445" y="420" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="n_34" value="9. INSERT INTO users (username, password, salt, full_name, role, is_active) / commit()" style="text;html=1;whiteSpace=wrap;rounded=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f2937;spacing=2;" vertex="1" parent="1"><mxGeometry x="1445" y="438" width="780" height="22" as="geometry"/></mxCell>
