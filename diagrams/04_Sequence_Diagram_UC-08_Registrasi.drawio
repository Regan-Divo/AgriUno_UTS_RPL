        <mxCell id="n_18" value="1. klik 'Belum punya akun? Daftar di sini'" style="text;html=1;whiteSpace=wrap;rounded=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f2937;spacing=2;" vertex="1" parent="1"><mxGeometry x="165" y="150" width="520" height="22" as="geometry"/></mxCell>
