        <mxCell id="n_44" value="else [validasi gagal]" style="text;html=1;whiteSpace=wrap;rounded=0;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=14;fontStyle=1;fontColor=#1b4332;spacing=2;" vertex="1" parent="1"><mxGeometry x="70" y="602" width="1560" height="24" as="geometry"/></mxCell>
        <mxCell id="n_45" value="13. (False, pesan galat)  -  username sudah digunakan / peran 'admin' tidak dapat dipilih / konfirmasi password tidak sama" style="text;html=1;whiteSpace=wrap;rounded=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f2937;spacing=2;" vertex="1" parent="1"><mxGeometry x="1125" y="646" width="860" height="22" as="geometry"/></mxCell>
