        <mxCell id="n_48" value="else [alokasi berstatus 'Terkirim'  -&gt;  bersifat final (BR-09)]" style="text;html=1;whiteSpace=wrap;rounded=0;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=14;fontStyle=1;fontColor=#1b4332;spacing=2;" vertex="1" parent="1"><mxGeometry x="70" y="672" width="1560" height="24" as="geometry"/></mxCell>
        <mxCell id="n_49" value="13. (False, 'Alokasi berstatus 'Terkirim' bersifat final dan tidak dapat diubah/dihapus (BR-09).')" style="text;html=1;whiteSpace=wrap;rounded=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f2937;spacing=2;" vertex="1" parent="1"><mxGeometry x="1125" y="712" width="900" height="22" as="geometry"/></mxCell>
