        <mxCell id="n_16" value=":MySQL" style="text;html=1;whiteSpace=wrap;rounded=0;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=11;fontStyle=2;fontColor=#6b7280;spacing=2;" vertex="1" parent="1"><mxGeometry x="1340" y="82" width="210" height="30" as="geometry"/></mxCell>
        <mxCell id="n_17" value="db: agriuno" style="text;html=1;whiteSpace=wrap;rounded=0;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=11;fontStyle=2;fontColor=#6b7280;spacing=2;" vertex="1" parent="1"><mxGeometry x="1340" y="116" width="210" height="16" as="geometry"/></mxCell>
        <mxCell id="n_18" value="1. pilih lot panen pada kotak daftar, isi tujuan pengiriman dan jumlah dikirim" style="text;html=1;whiteSpace=wrap;rounded=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f2937;spacing=2;" vertex="1" parent="1"><mxGeometry x="165" y="150" width="640" height="22" as="geometry"/></mxCell>
        <mxCell id="l_19" style="endArrow=block;html=1;rounded=0;strokeColor=#1f2937;strokeWidth=1.4;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="165" y="168" as="sourcePoint"/><mxPoint x="485" y="168" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="n_20" value="2. klik 'Simpan'  -&gt;  simpan()" style="text;html=1;whiteSpace=wrap;rounded=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f2937;spacing=2;" vertex="1" parent="1"><mxGeometry x="485" y="186" width="700" height="22" as="geometry"/></mxCell>
        <mxCell id="l_21" style="endArrow=block;html=1;rounded=0;strokeColor=#1f2937;strokeWidth=1.4;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="485" y="204" as="sourcePoint"/><mxPoint x="805" y="204" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="n_22" value="3. tambah_distribusi(id_panen, tujuan, jumlah)  -&gt;  validasi kolom dan jumlah &gt; 0" style="text;html=1;whiteSpace=wrap;rounded=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f2937;spacing=2;" vertex="1" parent="1"><mxGeometry x="805" y="222" width="820" height="22" as="geometry"/></mxCell>
        <mxCell id="l_23" style="endArrow=block;html=1;rounded=0;strokeColor=#1f2937;strokeWidth=1.4;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="805" y="240" as="sourcePoint"/><mxPoint x="1125" y="240" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="n_24" value="4. create_with_stock_check(id_panen, tujuan, jumlah, 'Diproses')  -&gt;  BEGIN TRANSACTION" style="text;html=1;whiteSpace=wrap;rounded=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f2937;spacing=2;" vertex="1" parent="1"><mxGeometry x="1125" y="258" width="900" height="22" as="geometry"/></mxCell>
        <mxCell id="l_25" style="endArrow=block;html=1;rounded=0;strokeColor=#1f2937;strokeWidth=1.4;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1125" y="276" as="sourcePoint"/><mxPoint x="1445" y="276" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="n_26" value="5. SELECT p.jumlah_berat, COALESCE(SUM(d.jumlah_dikirim),0) FROM inventori_panen p LEFT JOIN distribusi d ... FOR UPDATE" style="text;html=1;whiteSpace=wrap;rounded=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f2937;spacing=2;" vertex="1" parent="1"><mxGeometry x="1445" y="294" width="1000" height="22" as="geometry"/></mxCell>
        <mxCell id="l_27" style="endArrow=block;html=1;rounded=0;strokeColor=#1f2937;strokeWidth=1.4;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1445" y="312" as="sourcePoint"/><mxPoint x="1125" y="312" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="n_28" value="6. sisa_stok = jumlah_berat - total_dikirim" style="text;html=1;whiteSpace=wrap;rounded=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f2937;spacing=2;" vertex="1" parent="1"><mxGeometry x="1125" y="330" width="760" height="22" as="geometry"/></mxCell>
        <mxCell id="l_29" style="endArrow=block;html=1;rounded=0;strokeColor=#1f2937;strokeWidth=1.4;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1125" y="348" as="sourcePoint"/><mxPoint x="1445" y="348" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="n_30" value="7. INSERT INTO distribusi (id_panen, tujuan_pengiriman, jumlah_dikirim, status_pengiriman) VALUES (..., 'Diproses') / commit()" style="text;html=1;whiteSpace=wrap;rounded=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f2937;spacing=2;" vertex="1" parent="1"><mxGeometry x="1445" y="366" width="900" height="22" as="geometry"/></mxCell>
        <mxCell id="l_31" style="endArrow=block;html=1;rounded=0;strokeColor=#1f2937;strokeWidth=1.4;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1445" y="384" as="sourcePoint"/><mxPoint x="1125" y="384" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="n_32" value="8. (True, id_distribusi)" style="text;html=1;whiteSpace=wrap;rounded=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f2937;spacing=2;" vertex="1" parent="1"><mxGeometry x="1125" y="402" width="640" height="22" as="geometry"/></mxCell>
        <mxCell id="l_33" style="endArrow=block;html=1;rounded=0;strokeColor=#1f2937;strokeWidth=1.4;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1125" y="420" as="sourcePoint"/><mxPoint x="805" y="420" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="n_34" value="9. (True, 'Alokasi pengiriman berhasil dibuat (Status Awal: Diproses)!')" style="text;html=1;whiteSpace=wrap;rounded=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f2937;spacing=2;" vertex="1" parent="1"><mxGeometry x="805" y="438" width="700" height="22" as="geometry"/></mxCell>
        <mxCell id="l_35" style="endArrow=block;html=1;rounded=0;strokeColor=#1f2937;strokeWidth=1.4;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="805" y="456" as="sourcePoint"/><mxPoint x="485" y="456" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="n_36" value="10. load_table() dan load_panen()  -&gt;  muat ulang tabel alokasi serta daftar lot beserta sisa stok" style="text;html=1;whiteSpace=wrap;rounded=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f2937;spacing=2;" vertex="1" parent="1"><mxGeometry x="485" y="474" width="760" height="22" as="geometry"/></mxCell>
        <mxCell id="l_37" style="endArrow=block;html=1;rounded=0;strokeColor=#1f2937;strokeWidth=1.4;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="485" y="492" as="sourcePoint"/><mxPoint x="165" y="492" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="n_38" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#dc2626;strokeWidth=1.2;dashed=0;" vertex="1" parent="1"><mxGeometry x="60" y="520" width="1580" height="140" as="geometry"/></mxCell>
        <mxCell id="n_39" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dc2626;strokeColor=#dc2626;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="60" y="520" width="1580" height="28" as="geometry"/></mxCell>
        <mxCell id="n_40" value="else [jumlah kirim melebihi sisa stok (BR-02)]" style="text;html=1;whiteSpace=wrap;rounded=0;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=14;fontStyle=1;fontColor=#1b4332;spacing=2;" vertex="1" parent="1"><mxGeometry x="70" y="522" width="1560" height="24" as="geometry"/></mxCell>
        <mxCell id="n_41" value="11. (False, 'Jumlah kirim melebihi sisa stok inventori yang tersedia di gudang! (Sisa: 90.00 Kg)')  -&gt;  ROLLBACK" style="text;html=1;whiteSpace=wrap;rounded=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f2937;spacing=2;" vertex="1" parent="1"><mxGeometry x="1125" y="562" width="900" height="22" as="geometry"/></mxCell>
        <mxCell id="l_42" style="endArrow=block;html=1;rounded=0;strokeColor=#1f2937;strokeWidth=1.4;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1125" y="580" as="sourcePoint"/><mxPoint x="805" y="580" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="n_43" value="12. (False, pesan)  -&gt;  kotak dialog 'Validasi Stok (BR-02)'" style="text;html=1;whiteSpace=wrap;rounded=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f2937;spacing=2;" vertex="1" parent="1"><mxGeometry x="805" y="598" width="760" height="22" as="geometry"/></mxCell>
        <mxCell id="l_44" style="endArrow=block;html=1;rounded=0;strokeColor=#1f2937;strokeWidth=1.4;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="805" y="616" as="sourcePoint"/><mxPoint x="485" y="616" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="l_45" style="endArrow=block;html=1;rounded=0;strokeColor=#1f2937;strokeWidth=1.4;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="485" y="634" as="sourcePoint"/><mxPoint x="165" y="634" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="n_46" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#dc2626;strokeWidth=1.2;dashed=0;" vertex="1" parent="1"><mxGeometry x="60" y="670" width="1580" height="140" as="geometry"/></mxCell>
