        <mxCell id="n_54" value="opt [Ubah Status Pengiriman - hanya tiga nilai baku (BR-05)]" style="text;html=1;whiteSpace=wrap;rounded=0;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=14;fontStyle=1;fontColor=#1b4332;spacing=2;" vertex="1" parent="1"><mxGeometry x="70" y="792" width="1560" height="24" as="geometry"/></mxCell>
        <mxCell id="n_55" value="14. ubah_status_distribusi(id, status)  -&gt;  UPDATE distribusi SET status_pengiriman = %s WHERE id_distribusi = %s / commit()" style="text;html=1;whiteSpace=wrap;rounded=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f2937;spacing=2;" vertex="1" parent="1"><mxGeometry x="485" y="826" width="900" height="22" as="geometry"/></mxCell>
