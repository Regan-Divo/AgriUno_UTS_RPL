        <mxCell id="n_28" value="7. hash dan salt lama tersimpan" style="text;html=1;whiteSpace=wrap;rounded=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f2937;spacing=2;" vertex="1" parent="1"><mxGeometry x="1445" y="356" width="760" height="22" as="geometry"/></mxCell>
        <mxCell id="l_29" style="endArrow=block;html=1;rounded=0;strokeColor=#1f2937;strokeWidth=1.4;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1445" y="374" as="sourcePoint"/><mxPoint x="1125" y="374" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="n_30" value="8. SHA-256(salt + kata sandi lama) -&gt; hmac.compare_digest() dengan hash tersimpan" style="text;html=1;whiteSpace=wrap;rounded=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f2937;spacing=2;" vertex="1" parent="1"><mxGeometry x="1125" y="392" width="900" height="22" as="geometry"/></mxCell>
        <mxCell id="n_31" value="9. hash_baru = SHA-256(salt + sandi baru) memakai salt yang sama" style="text;html=1;whiteSpace=wrap;rounded=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f2937;spacing=2;" vertex="1" parent="1"><mxGeometry x="1125" y="428" width="940" height="22" as="geometry"/></mxCell>
        <mxCell id="n_32" value="10. UPDATE users SET password = %s WHERE id_user = %s" style="text;html=1;whiteSpace=wrap;rounded=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f2937;spacing=2;" vertex="1" parent="1"><mxGeometry x="1125" y="464" width="900" height="22" as="geometry"/></mxCell>
