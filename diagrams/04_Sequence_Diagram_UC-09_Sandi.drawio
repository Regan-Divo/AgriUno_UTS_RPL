        <mxCell id="n_25" value="5. validasi: kolom wajib, panjang baru minimal 6 karakter, konfirmasi sama" style="text;html=1;whiteSpace=wrap;rounded=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f2937;spacing=2;" vertex="1" parent="1"><mxGeometry x="1125" y="284" width="940" height="22" as="geometry"/></mxCell>
        <mxCell id="n_26" value="6. SELECT password, salt FROM users WHERE id_user = %s" style="text;html=1;whiteSpace=wrap;rounded=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f2937;spacing=2;" vertex="1" parent="1"><mxGeometry x="1125" y="320" width="900" height="22" as="geometry"/></mxCell>
