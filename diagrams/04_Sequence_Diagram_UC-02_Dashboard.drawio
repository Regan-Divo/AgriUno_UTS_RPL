        <mxCell id="n_36" value="10. SELECT COUNT(DISTINCT p.id_petani) ... INNER JOIN inventori_panen ip" style="text;html=1;whiteSpace=wrap;rounded=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f2937;spacing=2;" vertex="1" parent="1"><mxGeometry x="1125" y="464" width="900" height="22" as="geometry"/></mxCell>
        <mxCell id="l_37" style="endArrow=block;html=1;rounded=0;strokeColor=#1f2937;strokeWidth=1.4;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1125" y="482" as="sourcePoint"/><mxPoint x="1445" y="482" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="n_38" value="11. SELECT jenis_komoditas, SUM(jumlah_berat) ... ORDER BY berat DESC LIMIT 3" style="text;html=1;whiteSpace=wrap;rounded=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f2937;spacing=2;" vertex="1" parent="1"><mxGeometry x="1125" y="500" width="940" height="22" as="geometry"/></mxCell>
