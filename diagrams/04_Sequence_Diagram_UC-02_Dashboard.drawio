        <mxCell id="n_24" value="4. SELECT COUNT(*) AS t FROM petani" style="text;html=1;whiteSpace=wrap;rounded=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f2937;spacing=2;" vertex="1" parent="1"><mxGeometry x="1125" y="248" width="720" height="22" as="geometry"/></mxCell>
