        <mxCell id="n_28" value="6. SELECT COUNT(*) AS t FROM inventori_panen / FROM distribusi" style="text;html=1;whiteSpace=wrap;rounded=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f2937;spacing=2;" vertex="1" parent="1"><mxGeometry x="1125" y="320" width="900" height="22" as="geometry"/></mxCell>
