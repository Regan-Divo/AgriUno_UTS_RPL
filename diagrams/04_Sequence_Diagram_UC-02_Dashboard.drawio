        <mxCell id="n_34" value="9. nilai setoran dan nilai kirim" style="text;html=1;whiteSpace=wrap;rounded=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f2937;spacing=2;" vertex="1" parent="1"><mxGeometry x="1445" y="428" width="820" height="22" as="geometry"/></mxCell>
