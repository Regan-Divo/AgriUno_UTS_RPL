        <mxCell id="n_40" value="12. SELECT ... FROM inventori_panen UNION ALL SELECT ... FROM distribusi" style="text;html=1;whiteSpace=wrap;rounded=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f2937;spacing=2;" vertex="1" parent="1"><mxGeometry x="1125" y="536" width="940" height="22" as="geometry"/></mxCell>
