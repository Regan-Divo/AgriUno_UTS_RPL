        <mxCell id="n_26" value="5. total petani terdaftar" style="text;html=1;whiteSpace=wrap;rounded=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f2937;spacing=2;" vertex="1" parent="1"><mxGeometry x="1445" y="284" width="700" height="22" as="geometry"/></mxCell>
