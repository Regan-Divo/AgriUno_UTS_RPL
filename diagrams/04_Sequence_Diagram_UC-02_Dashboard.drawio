        <mxCell id="n_30" value="7. total lot panen, total alokasi, total setor, dan total kirim" style="text;html=1;whiteSpace=wrap;rounded=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f2937;spacing=2;" vertex="1" parent="1"><mxGeometry x="1445" y="356" width="900" height="22" as="geometry"/></mxCell>
        <mxCell id="l_31" style="endArrow=block;html=1;rounded=0;strokeColor=#1f2937;strokeWidth=1.4;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1445" y="374" as="sourcePoint"/><mxPoint x="1125" y="374" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="n_32" value="8. SELECT COALESCE(SUM(jumlah_berat),0) / SUM(jumlah_dikirim)" style="text;html=1;whiteSpace=wrap;rounded=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#1f2937;spacing=2;" vertex="1" parent="1"><mxGeometry x="1125" y="392" width="900" height="22" as="geometry"/></mxCell>
